{
  "name": "khayt",
  "version": "1.0.1",
  "description": "Khayt — 3D printing production management, invoicing & analytics. Free & open to all makers worldwide.",
  "main": "main.js",
  "author": "Khayt",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "dependencies": {
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.khayt.hub",
    "productName": "Khayt",
    "directories": {
      "output": "build",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        { "target": "dmg" }
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Khayt ${version}"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/khayt.iconset/icon_256x256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Khayt"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "assets/icon_preview.png",
      "category": "Office",
      "description": "3D printing production management, invoicing & analytics"
    }
  }
}
