{
  "name": "khayt",
  "version": "2.0.15",
  "description": "Khayt - 3D printing production management, invoicing and analytics. Free and open to all makers worldwide.",
  "main": "main.js",
  "author": {
    "name": "Khayt",
    "email": "support@khayt.app"
  },
  "license": "MIT-Commons-Clause",
  "private": false,
  "scripts": {
    "postinstall": "node scripts/install-electron-await.js",
    "install:electron": "node scripts/install-electron-await.js",
    "start": "node scripts/ensure-electron.js && electron .",
    "pack": "electron-builder --dir",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "localtunnel": "^2.0.2",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "playwright-core": "^1.60.0"
  },
  "overrides": {
    "yauzl": "^3.3.1"
  },
  "build": {
    "appId": "app.khayt.hub",
    "productName": "Khayt",
    "publish": {
      "provider": "github",
      "owner": "Alballaa",
      "repo": "Khayt"
    },
    "directories": {
      "output": "build",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Khayt ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/khayt.iconset/icon_256x256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Khayt"
    },
    "appx": {
      "applicationId": "Khayt",
      "backgroundColor": "#0F172A",
      "showNameOnTiles": false,
      "languages": [
        "en-US"
      ],
      "publisherDisplayName": "Khayt",
      "identityName": "Khayt.Khayt",
      "publisher": "CN=F9AECB56-B63C-4BD8-BAF1-B8CDA4A8B0BC"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon_preview.png",
      "category": "Office",
      "description": "3D printing production management, invoicing & analytics"
    }
  }
}
